@startuml component_interactions
' ==============================================================
' ==== Packages / High‑level components =========================
' ==============================================================

package "CLI Scripts" {
    [convert_any_to_hdf5.py]          as ConvIn
    [convert_hdf5_to_format.py]      as ConvOut
}

package "Argument Parsing" {
    [argparse]                        as ArgParse
}

package "Logging Utilities" {
    [converters.utils.common]         as LogUtil
    note right of LogUtil::configure_logging configure_logging() endnote
}

package "Zip Helper" {
    [converters.utils.zip_helper]     as ZipHelper
    note right of ZipHelper::zip_directory zip_directory() endnote
}

package "Protocol Registry" {
    [converters.factory.protocol_registry] as BuilderRegistry
    note right of BuilderRegistry::PROTOCOL_BUILDERS PROTOCOL_BUILDERS[protocol] endnote
}

package "Builders / Factories" {
    [converters.factory.amu_factory]          as AMUFactory
    [converters.factory.basal_ganglia_factory] as BGFFactory
}

package "Schema Objects" {
    [MasterBundle]               as MB
    [StandardFormatGroup]        as StdFmt
    [RawBundleGroup]             as RawGrp
    [ProtocolGroup]              as ProtoGrp
    [Simulation]                 as Sim
    [SpikeMap]                   as SpikeMap
    [StimuliGroup]               as StimGrp
    [Population]                 as Pop
    [Neuron]                     as Neur
}

package "Exporters" {
    [converters.exporters.amu_exporter]          as AMUExp
    [converters.exporters.basal_ganglia_exporter] as BGExp
    [converters.exporters.protocol_exporter]     as BaseExp <<ABC>>
}

package "Exporter Registry" {
    [converters.exporters.registry] as ExporterRegistry
    note right of ExporterRegistry::PROTOCOL_EXPORTERS PROTOCOL_EXPORTERS[protocol] endnote
}

package "Validation & Helpers" {
    [converters.utils.validation] as Validator
    [converters.utils.helpers]    as Helpers
    [converters.utils.dataset_helpers] as DSHelpers
    [converters.utils.compound_attribute] as CompAttr
    [converters.utils.units]      as Units
}

' ==============================================================
' ==== Relationships / Interactions ============================
' ==============================================================

' CLI → ArgParse
ConvIn  --> ArgParse : parse arguments
ConvOut --> ArgParse : parse arguments

' CLI → Logging
ConvIn  --> LogUtil   : configure_logging()
ConvOut --> LogUtil   : configure_logging()

' CLI → ZipHelper (only when raw bundle required)
ConvIn  --> ZipHelper : zip_directory()

' CLI → Builder Registry
ConvIn  --> BuilderRegistry : PROTOCOL_BUILDERS[protocol]

' Builder Registry → Specific Builder
BuilderRegistry --> AMUFactory : AMUBuilder
BuilderRegistry --> BGFFactory : BasalGangliaBuilder

' Builders → Factory functions (self‑call shown for clarity)
AMUFactory --> AMUFactory : build_amu_master_bundle(...)
BGFFactory --> BGFFactory : build_bg_master_bundle(...)

' Factory → Schema objects (populate)
AMUFactory --> MB : returns MasterBundle
BGFFactory --> MB : returns MasterBundle
MB --> StdFmt
MB --> RawGrp
MB --> ProtoGrp

' Schema → HDF5 (serialization helpers)
StdFmt  --> DSHelpers : make_group / store_dataset
RawGrp  --> DSHelpers : make_group / store_dataset
ProtoGrp --> DSHelpers : make_group / store_dataset
StimGrp --> CompAttr  : write_compound_attr / read_compound_attr
Population --> Neur   : to_hdf5 / from_hdf5
Neuron --> DSHelpers : store_dataset / read_dataset

' CLI (convert_hdf5_to_format) → Validator
ConvOut --> Validator : validate_master_bundle()

' CLI → Exporter Registry
ConvOut --> ExporterRegistry : PROTOCOL_EXPORTERS[protocol]

' Exporter Registry → Concrete Exporter
ExporterRegistry --> AMUExp : AMUExporter
ExporterRegistry --> BGExp : BasalGangliaExporter
AMUExp --> BaseExp : implements
BGExp --> BaseExp : implements

' Exporter → Helpers (stimulus, firing‑rate, normalisation)
AMUExp --> Helpers : get_discretized_stimulus\nget_firing_rates\nnormalize
BGExp --> Helpers : (none – uses only HDF5 helpers)

' Exporter → Schema objects (read)
AMUExp --> Sim : read Config / SimParams / StimuliGroup / SpikeMap
BGExp --> Sim : read Config / SimParams / StimuliGroup / SpikeMap

' Exporter → numpy (output)
AMUExp --> npz : np.savez_compressed()
BGExp --> npz : np.savez()

' Exporter → Logging
AMUExp --> LogUtil : logger.info / error
BGExp --> LogUtil : logger.info / error

' Validation uses low‑level checks
Validator --> DSHelpers : _require_*, _require_group, …

' Units & Compound Attribute are used by many schema classes
StdFmt --> Units
StimGrp --> Units
CompAttr --> Units

@enduml