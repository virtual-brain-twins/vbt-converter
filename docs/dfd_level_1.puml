@startuml dfd_level_1
' ==== Actors ====
actor User

' ==== Data Stores ====
folder "Input Directory / CSV" as IN_DIR
folder "Protocol PDF (optional)" as PROTO_PDF
file "Raw ZIP (tmp)" as RAW_ZIP
database "MasterBundle (HDF5)" as H5_BUNDLE
folder "Exported Files (.npz, .dsr.npz)" as OUT_FILES

' ==== Processes (inside convert_any_to_hdf5) ====
rectangle "Parse CLI arguments\n(argparse)" as PARSE_ARGS
rectangle "Configure Logging\n(configure_logging)" as LOG_CFG
rectangle "Zip raw data (optional)\n(zip_directory)" as ZIP_RAW
rectangle "Select Protocol Builder\n(PROTOCOL_BUILDERS)" as SELECT_BUILDER
rectangle "Build MasterBundle\n(ProtocolBuilder.__call__)" as BUILD_BUNDLE
rectangle "Write HDF5 file\n(MasterBundle.to_hdf5)" as WRITE_H5

' ==== Data Flows ====
User --> PARSE_ARGS : run script
PARSE_ARGS --> LOG_CFG : log‑level
PARSE_ARGS --> IN_DIR : -i / --input
PARSE_ARGS --> PROTO_PDF : --protocol‑info‑path
PARSE_ARGS --> RAW_ZIP : --no‑raw‑bundle (negated)
PARSE_ARGS --> SELECT_BUILDER : --protocol

LOG_CFG --> ZIP_RAW : logger
ZIP_RAW --> RAW_ZIP : create zip (if enabled)

SELECT_BUILDER --> BUILD_BUNDLE : builder object (AMUBuilder / BasalGangliaBuilder)
BUILD_BUNDLE --> IN_DIR : input_path
BUILD_BUNDLE --> RAW_ZIP : embed_raw_path (optional)
BUILD_BUNDLE --> PROTO_PDF : protocol_info_path
BUILD_BUNDLE --> H5_BUNDLE : returns MasterBundle

WRITE_H5 --> H5_BUNDLE : serialize + metadata
WRITE_H5 --> OUT_FILES : .h5 file created

User --> OUT_FILES : final master bundle ready
@enduml