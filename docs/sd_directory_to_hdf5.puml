@startuml
title Sequence – convert_any_to_hdf5 (raw → master HDF5)

actor User
participant "CLI (convert_any_to_hdf5)" as CLI
participant "PROTOCOL_BUILDERS registry" as Registry
participant "ProtocolBuilder (e.g. AMUBuilder)" as Builder
participant "Factory (build_amu_master_bundle)" as Factory
participant "Schema objects" as Schema
participant "ZIP helper (optional)" as ZipHelper
participant "HDF5 file" as H5File
participant "RawBundleGroup (optional)" as RawBundle

User -> CLI : invoke script with args
CLI -> Registry : PROTOCOL_BUILDERS[protocol]
Registry --> Builder : return concrete builder
CLI -> Builder : __call__(input_path, embed_raw, embed_raw_path, out_dir)
Builder -> Factory : build_*_master_bundle(...)
Factory -> Factory : read raw files (npz, yaml, json, h5)
Factory -> Schema : instantiate Simulation / SpikeMap / StimulusSet / …
alt embed_raw = True
    Factory -> ZipHelper : zip_directory(src_root, embed_raw_path)
    ZipHelper -> RawBundle : ExternalLink.attach()
end
Factory --> Builder : MasterBundle instance
Builder -> Schema : MasterBundle.to_hdf5(out_path)
Schema -> H5File : open/write, write format_version
Schema -> H5File : StandardFormatGroup.to_hdf5()
Schema -> H5File : RawBundleGroup.to_hdf5() (if present)
H5File --> Schema : success
Builder --> CLI : MasterBundle written
CLI -> User : log.info("Finished – master file written …")
@enduml