@startuml sd_hdf5_to_protocol_format
' Participants ---------------------------------------------------------------
actor User as u
participant "CLI (convert_hdf5_to_format.py)" as cli
participant "argparse.Namespace\n(args)" as args
participant "logging (root)" as rootlog
participant "validation.validate_master_bundle()" as validator
database "Master HDF5 Bundle\n(master.h5)" as h5file
participant "PROTOCOL_EXPORTERS\nregistry" as exporter_reg
participant "Exporter Class\n(RateExporter)" as exporter
participant "Exporter Instance\n(exp_inst)" as exp_inst
participant "npz writer (numpy)" as npz

' 1️⃣  Argument parsing & logging -------------------------------------------
u -> cli : python convert_hdf5_to_format.py \n-i master.h5 -o out_dir \nprotocol uva_amu_1 -b 0.001 \n[--meta‑author …] [--strict] [...]
cli -> args : parser.parse_args()
cli -> rootlog : logging.basicConfig(level=args.log_level)

' 2️⃣  Validation (strict mode controls optional groups) --------------------
cli -> validator : validate_master_bundle(\n    bundle_path=args.input,\n    strict=args.strict,\n    version=args.version,\n    logger=rootlog)
validator --> cli : raises ValidationError? (no)

'   Validation internals (shown as notes for clarity) ------------------------
note right of validator
  * Checks root attribute “format_version”
  * Reads integer attributes
    - format_version_major
    - format_version_minor
    - format_version_patch
  * If strict:
    – validates optional “RawBundle” group
    – validates optional “Protocol” group (Version attribute + compressed Content)
  * Per‑simulation checks depend on version:
    – v1.0 : expects OutputSpikes/SpikeMap
    – v2.0 : expects Output/Map with datasets
      times (1‑D), voltage (1‑D)
end note

' 3️⃣  Open the HDF5 file ----------------------------------------------------
cli -> h5file : h5py.File(args.input, "r")  (read‑only)

' 4️⃣  Resolve the exporter -------------------------------------------------
cli -> exporter_reg : PROTOCOL_EXPORTERS[args.protocol]
exporter_reg --> cli : exporter class (RateExporter)

' 5️⃣  Initialise the exporter (bin‑size, log‑level, metadata…) -------------
cli -> exporter : __init__(master_h5=h5file,\n                out_dir=args.out_dir,\n                bin_size=args.bin_size,\n                log_level=args.log_level,\n                meta=args.meta)
activate exporter
exporter -> exp_inst : create instance
deactivate exporter

' 6️⃣  Exporter reads every simulation ---------------------------------------
exp_inst -> h5file : iterate over /StandardFormat/Simulations/Sim_<ID>
loop for each simulation group
    exp_inst -> exp_inst : extract_one_simulation()
    note right of exp_inst
      Reads sub‑groups:
        Configuration/
        Parameters/
        Stimuli/
        Output/Map   ← new hierarchy
    end note
    exp_inst -> Map : Map.from_hdf5(sim_grp["Output"]["Map"])
    activate Map
    Map --> exp_inst : Map object (populations → neurons)
    deactivate Map

    ' 7️⃣  Convert spike/voltage data to firing‑rate bins --------------------
    exp_inst -> exp_inst : get_firing_rates(populations, bin_size)
    note right of exp_inst
      Uses new neuron fields:
        times, times_unit
        voltage, voltage_unit
    end note

    ' 8️⃣  Write numpy‑compressed output ------------------------------------
    exp_inst -> npz : np.savez_compressed(\n    out_path,\n    rate=rate_array,\n    meta=meta_dict)\n
end

' 9️⃣  Finish ---------------------------------------------------------------
cli -> rootlog : logger.info("All done …")
cli --> u : exit 0
@enduml