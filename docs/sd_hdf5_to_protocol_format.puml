@startuml sd_hdf5_to_protocol_format
actor User as u
participant "CLI (convert_hdf5_to_format.py)" as cli
participant "argparse.Namespace" as args
participant "logging (root)" as rootlog
participant "validation.validate_master_bundle()" as validator
database "Master HDF5 Bundle\n(master.h5)" as h5file
participant "PROTOCOL_EXPORTERS\nregistry" as exporter_reg
participant "Exporter Class\n(RateExporter)" as exporter
participant "Exporter Instance" as exp_inst
participant "npz writer (numpy)" as npz

u -> cli : python convert_hdf5_to_format.py -i master.h5 -o out_dir uva_amu_1 -b 0.001
cli -> args : parser.parse_args()
cli -> rootlog : logging.basicConfig(level=args.log_level)

cli -> validator : validate_master_bundle(bundle_path, strict=args.strict)
validator --> cli : raises ValidationError? (no)

cli -> h5file : h5py.File(master.h5, "r")  (read‑only)
cli -> exporter_reg : PROTOCOL_EXPORTERS[args.protocol]
exporter_reg --> cli : exporter class (RateExporter)

cli -> exporter : configure_parser() (already done by argparse)

cli -> exporter : __init__(master_h5, out_dir, bin_size=args.bin_size, log_level=log_lvl)
activate exporter
exporter -> exp_inst : create instance
exp_inst -> h5file : read simulation groups
exp_inst -> exp_inst : extract_one_simulation() (per simulation)
exp_inst -> npz : np.savez_compressed(...)
deactivate exporter

cli -> rootlog : logger.info("All done …")
cli --> u : exit 0
@enduml